{
  "name": "xiangqi-endgame-training",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "wasm:build": "wasm-pack build ../../crates/web-core --target web --out-dir public/wasm --out-name xiangqi_web_core",
    "dev": "vite --host 0.0.0.0 --port 1422",
    "build": "tsc && vite build",
    "mobile:build": "pnpm wasm:build && pnpm build",
    "android:sync": "pnpm mobile:build && cap sync android",
    "android:apk": "pnpm android:sync && bash ../../scripts/build-endgame-training-apk.sh",
    "android:debug": "pnpm android:sync && cd android && ./gradlew :app:assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
