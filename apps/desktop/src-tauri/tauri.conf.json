{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xiangqi Studio",
  "version": "1.0.0",
  "identifier": "cn.xiangqi.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Xiangqi Studio", "width": 1440, "height": 900, "minWidth": 1080, "minHeight": 720 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../../THIRD_PARTY_NOTICES.md",
      "resources/fonts/OFL.txt",
      "resources/pikafish/pikafish",
      "resources/pikafish/pikafish.nnue",
      "resources/pikafish/Copying.txt",
      "resources/pikafish/Pikafish-README.md",
      "resources/pikafish/RESOURCE-MANIFEST.txt",
      "resources/link-vision",
      "resources/master-style",
      "resources/flyknife-library",
      "resources/book-topics"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "installer-hooks.nsh",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
