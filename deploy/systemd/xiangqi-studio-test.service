[Unit]
Description=Xiangqi Studio test API
After=network-online.target mysqld.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/xiangqi-studio-test/current
EnvironmentFile=/etc/xiangqi-studio/test.env
ExecStart=/opt/xiangqi-studio-test/current/xiangqi-server
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
StandardOutput=append:/var/log/xiangqi-studio/test.log
StandardError=append:/var/log/xiangqi-studio/test.log
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
