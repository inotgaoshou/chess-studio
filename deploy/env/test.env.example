# Copy to /etc/xiangqi-studio/test.env. Keep that file owned by root:root
# with mode 0600. This account and JWT secret must not be shared with production.
DATABASE_URL=mysql://xiangqi_studio_test:REPLACE_WITH_NEW_PASSWORD@127.0.0.1:3456/chess_test
JWT_SECRET=REPLACE_WITH_A_DIFFERENT_64_HEX_CHARACTER_SECRET
BIND_ADDR=127.0.0.1:8081
RUST_LOG=info,tower_http=info

ALLOWED_ORIGINS=https://qixiapp.cn,https://localhost,capacitor://localhost
GUEST_ANALYSIS_ENABLED=false
GUEST_TOKEN_TTL_MINUTES=120
GUEST_DAILY_ANALYSIS_LIMIT=10
GUEST_TOKEN_IP_DAILY_LIMIT=5
ANALYSIS_IP_PER_MINUTE_LIMIT=5
USER_ANALYSIS_PER_MINUTE_LIMIT=10
ENGINE_MAX_CONCURRENT=1
ENGINE_MAX_QUEUED=16
