# Copy to /etc/xiangqi-studio/production.env. Keep that file owned by root:root
# with mode 0600. Do not commit the copied file.
#
# Use a dedicated MySQL account and percent-encode reserved characters in its
# password. A password generated with `openssl rand -hex 32` needs no encoding.
DATABASE_URL=mysql://xiangqi_studio_prod:REPLACE_WITH_NEW_PASSWORD@127.0.0.1:3456/chess
JWT_SECRET=REPLACE_WITH_A_DIFFERENT_64_HEX_CHARACTER_SECRET
BIND_ADDR=127.0.0.1:8080
RUST_LOG=info,tower_http=info

# Only HTTPS public origins are accepted. The localhost values are HTTPS and
# Capacitor native WebView origins on the user's device, never remote HTTP.
ALLOWED_ORIGINS=https://qixiapp.cn,https://localhost,capacitor://localhost
GUEST_ANALYSIS_ENABLED=false
GUEST_TOKEN_TTL_MINUTES=120
GUEST_DAILY_ANALYSIS_LIMIT=30
GUEST_TOKEN_IP_DAILY_LIMIT=20
ANALYSIS_IP_PER_MINUTE_LIMIT=10
USER_ANALYSIS_PER_MINUTE_LIMIT=30
ENGINE_MAX_CONCURRENT=2
ENGINE_MAX_QUEUED=64

# Uncomment only after installing the server-side engine and model at stable
# paths outside a release directory.
# PIKAFISH_PATH=/opt/pikafish/pikafish
# PIKAFISH_ENGINE_VERSION=Pikafish-2026-09-06
# PIKAFISH_NNUE_VERSION=sha256:REPLACE_WITH_MODEL_SHA256
