# Copy to .env and replace the two placeholder values. Never commit .env.
DATABASE_URL=mysql://xiangqi:CHANGE_THIS_LOCAL_DEVELOPMENT_PASSWORD@127.0.0.1:3306/xiangqi
JWT_SECRET=replace-with-a-long-random-local-secret
BIND_ADDR=127.0.0.1:8080

# Optional: only needed for server-side cloud analysis, not for master-game browsing.
# PIKAFISH_PATH=/absolute/path/to/pikafish
ENGINE_THREADS=2
ENGINE_HASH_MB=256

# Optional: versioned reference-library package advertised to desktop clients.
# REFERENCE_LIBRARY_PACKAGE_VERSION=2026.09
# REFERENCE_LIBRARY_PACKAGE_URL=https://downloads.example.com/reference-library-2026.09.sqlite.zst
# REFERENCE_LIBRARY_PACKAGE_SHA256=replace-with-64-hex-character-sha256
# REFERENCE_LIBRARY_PACKAGE_GAME_COUNT=147994
# REFERENCE_LIBRARY_PACKAGE_PUBLISHED_AT=2026-09-08T00:00:00Z
